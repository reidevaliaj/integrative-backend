APP_NAME=Integrative Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg://integrative_user:replace-me@localhost:5432/integrative_backend
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

MYPOS_MODE=disabled
MYPOS_CONFIGURATION_PACK=
MYPOS_SID=
MYPOS_WALLET_NUMBER=
MYPOS_KEY_INDEX=
MYPOS_PRIVATE_KEY=
MYPOS_PUBLIC_CERTIFICATE=
MYPOS_CURRENCY=EUR
MYPOS_LANGUAGE=EN
MYPOS_PAYMENT_METHOD=1
MYPOS_PAYMENT_PARAMETERS_REQUIRED=3
MYPOS_MONTHLY_AMOUNT=
MYPOS_REQUEST_CARD_TOKEN=false
SUBSCRIPTION_PRICE_DISPLAY=Monthly digital access
