APP_NAME=Integrative Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg://integrative_user:replace-me@localhost:5432/integrative_backend
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

MOLLIE_MODE=disabled
MOLLIE_API_KEY=
MOLLIE_API_URL=https://api.mollie.com/v2
MOLLIE_MONTHLY_AMOUNT=22.00
MOLLIE_CURRENCY=EUR
MOLLIE_API_TIMEOUT_SECONDS=15

SUBSCRIPTION_PRICE_DISPLAY=EUR 22 / month
